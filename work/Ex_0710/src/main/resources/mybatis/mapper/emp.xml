<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="emp">
    <select id="all" resultType="mybatis.vo.EmpVO">
        SELECT * FROM emp
    </select>

    <select id="get_emp" resultType="mybatis.vo.EmpVO" parameterType="String">
        SELECT * FROM emp
        WHERE empno = #{no}
    </select>

    <select id="search" resultType="mybatis.vo.EmpVO" parameterType="Map">
        SELECT * FROM emp
        <trim prefix="where">
            <choose>
                <when test="searchType != null and searchType == 0"> <!--사번검색-->
                    empno = #{searchValue} <!--정확한 값을 입력해야 검색됨-->
                </when>
                <when test="searchType != null and searchType == 1"> <!--이름검색-->
                    ename LIKE CONCAT('%', #{searchValue}, '%') <!--포함된 문자열 검색-->
                </when>
                <when test="searchType != null and searchType == 2"> <!--직업검색-->
                    job LIKE CONCAT('%', #{searchValue}, '%') <!--포함된 문자열 검색-->
                </when>
                <when test="searchType != null and searchType == 3"> <!--부서검색-->
                    deptno = #{searchValue};
                </when>
            </choose>
        </trim>
    </select>
</mapper>
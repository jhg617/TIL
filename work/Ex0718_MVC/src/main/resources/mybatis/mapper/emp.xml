<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="emp">
    <select id="all" resultType="mybatis.vo.EmpVO">
        select * from emp
    </select>

    <insert id="add" parameterType="mybatis.vo.EmpVO">
        INSERT INTO emp(empno, ename, job, hiredate)
        VALUES(#{empno}, #{ename}, #{job}, NOW())
    </insert>

    <select id="search" resultType="mybatis.vo.EmpVO" parameterType="java.util.Map">
        SELECT * FROM emp
        <where>
            <if test="searchValue != null and searchValue != ''">
                <choose>
                    <when test="searchType == '0'">
                        empno = #{searchValue}
                    </when>
                    <when test="searchType == '1'">
                        ename LIKE CONCAT('%', #{searchValue}, '%')
                    </when>
                    <when test="searchType == '2'"> job LIKE CONCAT('%', #{searchValue}, '%') </when>
                    <when test="searchType == '3'"> deptno = #{searchValue} </when>
                </choose>
            </if>
        </where>
    </select>
</mapper>